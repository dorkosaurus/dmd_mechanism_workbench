    {
      "id": "03",
      "name": "Nonsense / splice variants → NMD → tissue-graded transcript loss",
      "subtitle": "Premature stop triggers surveillance; cardiac + brain isoforms less rescued",
      "supporting": 7411,
      "oddsRatio": 6.1,
      "evidence": 7.2,
      "druggability": 2,
      "therapeutic": "Readthrough agents (ataluren); NMD inhibitors under investigation",
      "selected": false,
      "detail": {
        "lede": "Nonsense mutations and canonical splice-site variants create a premature termination codon (PTC). Transcripts with a PTC ≥50 nt upstream of the last exon-exon junction are degraded by nonsense-mediated decay (NMD), yielding near-total dystrophin loss. NMD efficiency varies across tissues, so cardiac and brain-restricted isoforms sometimes retain trace expression — a tissue-graded loss pattern.",
        "evidence": [
          {
            "tone": "good",
            "text": "PTC ≥50 nt upstream of last EEJ triggers NMD in mammalian cells",
            "cite": "Popp & Maquat 2013"
          },
