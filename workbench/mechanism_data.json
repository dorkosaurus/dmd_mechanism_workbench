  "hypotheses": [
    {
      "id": "01",
      "name": "Out-of-frame deletions → truncated dystrophin → sarcolemmal fragility",
      "subtitle": "Monaco rule; loss of C-terminal DGC anchor; membrane tears → Ca²⁺ influx → necrosis",
      "supporting": 18204,
      "oddsRatio": 14.2,
      "evidence": 9.4,
      "druggability": 4,
      "therapeutic": "Exon-skipping ASOs (Dp427m rescue); micro-dystrophin gene therapy",
      "selected": true,
      "detail": {
        "lede": "Out-of-frame deletions in DMD ablate the C-terminal dystroglycan-binding domain, decoupling the sarcolemma from the extracellular matrix. Contraction stress produces membrane micro-tears, unregulated Ca²⁺ influx activates calpain and disrupts mitochondrial handling, triggering necrosis and progressive fibro-fatty replacement.",
        "evidence": [
          {
            "tone": "good",
            "text": "Monaco reading-frame rule: 90% of out-of-frame → DMD; 91% of in-frame → BMD",
            "cite": "Monaco 1988"
          },
          {
            "tone": "good",
            "text": "LOVD: 18,204 out-of-frame deletion entries vs 4,822 in-frame (matches 68% severe rate)",
            "cite": "LOVD-DMD 2026"
          },
          {
            "tone": "good",
            "text": "Dystrophin-null mdx muscle: elevated resting [Ca²⁺]ᵢ and calpain activation",
            "cite": "Turner 1988; Alderton 2000"
          },
          {
            "tone": "good",
            "text": "Membrane sealants (poloxamer-188) reduce sarcolemmal damage in mdx / GRMD",
            "cite": "Yasuda 2005"
          },
          {
            "tone": "good",
            "text": "Micro-dystrophin (rAAV) restores DGC + delays fibrosis in Phase III",
            "cite": "Mendell 2020; ELEVIDYS 2023"
          },
          {
            "tone": "good",
            "text": "Exon-51 skipping (eteplirsen) restores in-frame Dp427m in ~13% of pts",
            "cite": "Mendell 2013"
          },
          {
            "tone": "warn",
            "text": "Frame-rule exception: Δexon 5 in-frame → severe DMD via aberrant splicing",
            "cite": "Aartsma-Rus 2006"
          }
        ],
